<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SMOOSH – Find ur dream smoothies</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Baloo+2:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#2b1b4a; --card:#ffffffd9;
  --pink:#ff4fa3; --yellow:#ffd93d; --green:#2ee59d; --blue:#3ab4ff; --purple:#9b5cff; --orange:#ff8a3d;
  --r:26px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Fredoka',system-ui,sans-serif;color:var(--ink);min-height:100vh;overflow-x:hidden;
  background:linear-gradient(135deg,#ffe0f0,#fff3c4 35%,#d6fff0 65%,#d9ecff);background-attachment:fixed}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
:focus-visible{outline:3px solid var(--purple);outline-offset:3px}

/* background blobs */
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;animation:drift 18s ease-in-out infinite alternate}
.b1{width:420px;height:420px;background:var(--pink);top:-120px;left:-100px}
.b2{width:380px;height:380px;background:var(--yellow);top:30%;right:-120px;animation-delay:-5s}
.b3{width:420px;height:420px;background:var(--green);bottom:-160px;left:20%;animation-delay:-9s}
.b4{width:320px;height:320px;background:var(--blue);bottom:10%;right:15%;animation-delay:-3s}
@keyframes drift{to{transform:translate(60px,-50px) scale(1.15)}}

.view{min-height:100vh;animation:viewIn .5s ease both}
.hidden{display:none!important}
@keyframes viewIn{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}

/* ---------- HOME ---------- */
#home{display:grid;place-items:center;text-align:center;padding:24px 16px 90px;position:relative}
.logo{font-family:'Baloo 2';font-weight:800;font-size:clamp(3.2rem,11vw,7rem);line-height:1;letter-spacing:2px;
  background:linear-gradient(90deg,var(--pink),var(--orange),var(--yellow),var(--green),var(--blue),var(--purple),var(--pink));
  background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:flow 6s linear infinite;
  filter:drop-shadow(0 6px 0 #fff)}
@keyframes flow{to{background-position:300% 0}}
.slogan{font-size:clamp(1.2rem,4vw,2rem);font-weight:600;margin-top:6px}
.slogan b{color:var(--pink)}
.stage{perspective:900px;width:min(92vw,560px);height:clamp(340px,52vh,470px);margin-top:10px;position:relative;touch-action:none}
.scene{position:absolute;inset:0;transform-style:preserve-3d;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .15s ease-out}
.sway{position:absolute;inset:0;transform-style:preserve-3d;animation:sway 7s ease-in-out infinite}
@keyframes sway{0%,100%{transform:rotateY(-10deg)}50%{transform:rotateY(10deg)}}
.hero-cup{position:absolute;left:50%;top:50%;width:min(46%,230px);transform:translate(-50%,-50%) translateZ(10px);filter:drop-shadow(0 24px 24px #7a2bd055);
  animation:pop .9s cubic-bezier(.3,1.5,.5,1) both,float 4.5s ease-in-out .9s infinite}
.fx{position:absolute;left:50%;top:50%;font-size:clamp(2.6rem,9vw,4.2rem);cursor:pointer;user-select:none;
  transform:translate3d(var(--x),var(--y),var(--z)) translate(-50%,-50%);
  animation:pop .8s cubic-bezier(.3,1.7,.5,1) var(--d) both,float var(--t,4s) ease-in-out calc(var(--d) + .8s) infinite;filter:drop-shadow(0 12px 8px #0002)}
.fx.boing{animation:boing .6s ease both}
@keyframes pop{from{scale:0;opacity:0}to{scale:1;opacity:1}}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -16px}}
@keyframes boing{0%{scale:1;rotate:0}30%{scale:1.5;rotate:-20deg}60%{scale:.85;rotate:15deg}100%{scale:1;rotate:0}}
.ice{position:absolute;left:50%;top:50%;width:0;height:0;transform:translate3d(var(--x),var(--y),var(--z));transform-style:preserve-3d}
.cube{--s:54px;position:absolute;left:calc(var(--s)/-2);top:calc(var(--s)/-2);width:var(--s);height:var(--s);transform-style:preserve-3d;
  animation:spin var(--t,9s) linear infinite,pop .8s cubic-bezier(.3,1.7,.5,1) var(--d) both}
.cube i{position:absolute;inset:0;border:2px solid #fff;border-radius:10px;background:linear-gradient(135deg,#e6faff99,#9ee3ff77);box-shadow:inset 0 0 14px #fff}
.cube i:nth-child(1){transform:translateZ(calc(var(--s)/2))}
.cube i:nth-child(2){transform:rotateY(180deg) translateZ(calc(var(--s)/2))}
.cube i:nth-child(3){transform:rotateY(90deg) translateZ(calc(var(--s)/2))}
.cube i:nth-child(4){transform:rotateY(-90deg) translateZ(calc(var(--s)/2))}
.cube i:nth-child(5){transform:rotateX(90deg) translateZ(calc(var(--s)/2))}
.cube i:nth-child(6){transform:rotateX(-90deg) translateZ(calc(var(--s)/2))}
@keyframes spin{to{transform:rotate3d(1,1,0,360deg)}}
.hint{font-size:.95rem;opacity:.7;margin-top:4px}
.next{position:fixed;right:22px;bottom:20px;font-weight:700;font-size:1.3rem;padding:12px 26px;border-radius:999px;color:#fff;
  background:linear-gradient(90deg,var(--pink),var(--orange));box-shadow:0 8px 0 #c2307a,0 14px 24px #c2307a55;transition:transform .15s,box-shadow .15s;z-index:5}
.next span{display:inline-block;animation:nudge 1s ease-in-out infinite}
@keyframes nudge{50%{transform:translateX(7px)}}
.next:hover{transform:translateY(-3px)}
.next:active{transform:translateY(5px);box-shadow:0 3px 0 #c2307a}

/* ---------- EXPLORE ---------- */
#explore{padding:18px 16px 60px;max-width:1180px;margin:0 auto}
.topbar{display:flex;justify-content:space-between;align-items:center}
.brand{font-family:'Baloo 2';font-weight:800;font-size:1.7rem;background:linear-gradient(90deg,var(--pink),var(--purple));-webkit-background-clip:text;background-clip:text;color:transparent}
.pill{padding:8px 16px;border-radius:999px;background:#fff;font-weight:600;box-shadow:0 4px 0 #d9c9ff;transition:transform .15s}
.pill:hover{transform:translateY(-2px)}
.pill:active{transform:translateY(3px);box-shadow:0 1px 0 #d9c9ff}
.headline{text-align:center;margin:18px 0 14px}
.headline h2{font-family:'Baloo 2';font-size:clamp(1.8rem,5vw,2.8rem);line-height:1.1}
.headline p{opacity:.75}
.search{display:flex;align-items:center;gap:10px;max-width:640px;margin:0 auto;background:#fff;border-radius:999px;padding:8px 10px 8px 20px;
  box-shadow:0 8px 0 #ffb3d9,0 16px 30px #ff4fa333;border:3px solid var(--pink);transition:transform .2s}
.search:focus-within{transform:scale(1.02)}
.search input{flex:1;border:0;outline:0;font:inherit;font-size:1.1rem;background:transparent;color:var(--ink);min-width:0}
.search button{width:40px;height:40px;border-radius:50%;background:var(--pink);color:#fff;font-size:1.1rem}
.benefits{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:14px 0 4px}
.benefits span{background:#ffffffb0;padding:6px 14px;border-radius:999px;font-size:.88rem;font-weight:500}
.chips{display:flex;gap:10px;overflow-x:auto;padding:14px 4px 10px;scrollbar-width:thin;justify-content:safe center}
.chip{flex:none;padding:10px 18px;border-radius:999px;background:#fff;font-weight:600;border:3px solid transparent;transition:transform .2s,background .2s;white-space:nowrap}
.chip:hover{transform:translateY(-3px) rotate(-1.5deg)}
.chip.on{color:#fff;background:linear-gradient(120deg,var(--c1),var(--c2));box-shadow:0 5px 0 #0002;border-color:#fff}
.count{text-align:center;font-weight:500;opacity:.8;margin:4px 0 14px}
.blurb{text-align:center;max-width:640px;margin:0 auto 14px;font-size:.95rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:18px}
.card{position:relative;text-align:left;border-radius:var(--r);padding:16px;color:#fff;overflow:hidden;
  background:linear-gradient(150deg,var(--c1),var(--c2));box-shadow:0 8px 0 #0002,0 16px 28px #0002;
  animation:rise .5s cubic-bezier(.3,1.4,.5,1) both;animation-delay:calc(min(var(--i),18) * 35ms);transition:transform .25s cubic-bezier(.3,1.6,.5,1)}
.card::after{content:"";position:absolute;width:140px;height:140px;border-radius:50%;background:#ffffff30;right:-40px;top:-40px}
.card:hover{transform:translateY(-8px) rotate(-1.2deg) scale(1.03)}
.card:active{transform:scale(.97)}
@keyframes rise{from{opacity:0;transform:translateY(26px) scale(.9)}to{opacity:1;transform:none}}
.card .cup{width:70px;height:auto;display:block;margin:0 auto 6px;filter:drop-shadow(0 8px 6px #0003);transition:transform .3s}
.card:hover .cup{transform:rotate(8deg) translateY(-4px)}
.card h3{font-family:'Baloo 2';font-size:1.2rem;line-height:1.15;text-shadow:0 2px 0 #0003}
.card p{font-size:.84rem;margin-top:5px;opacity:.95}
.card .tag{display:inline-block;margin-top:8px;background:#fff;color:var(--ink);font-size:.75rem;font-weight:600;padding:3px 10px;border-radius:999px}
.empty{text-align:center;padding:50px 10px;font-size:1.2rem}
.empty b{display:block;font-size:3rem}
footer{text-align:center;margin-top:40px;font-size:.9rem;opacity:.7}

/* ---------- DETAIL ---------- */
#detail{padding:18px 16px 60px;max-width:1000px;margin:0 auto}
.dwrap{display:grid;grid-template-columns:minmax(220px,340px) 1fr;gap:26px;margin-top:20px;align-items:start}
.dcup{border-radius:34px;padding:26px 14px 18px;background:linear-gradient(150deg,var(--c1),var(--c2));box-shadow:0 10px 0 #0002,0 20px 36px #0003;text-align:center;position:sticky;top:16px;perspective:700px}
.dcup .cup{width:min(70%,200px);animation:float 4s ease-in-out infinite;filter:drop-shadow(0 18px 14px #0004);transition:transform .15s;transform:rotateX(var(--rx,0)) rotateY(var(--ry,0))}
.dcup .cat{display:inline-block;background:#fff;padding:4px 14px;border-radius:999px;font-weight:600;font-size:.85rem;margin-top:10px}
.panel{background:var(--card);border-radius:var(--r);padding:22px;box-shadow:0 8px 24px #7a2bd01f;backdrop-filter:blur(8px)}
.panel + .panel{margin-top:18px}
.panel h1{font-family:'Baloo 2';font-size:clamp(1.9rem,5vw,2.8rem);line-height:1.05}
.panel h2{font-family:'Baloo 2';font-size:1.4rem;margin-bottom:10px}
.tip{margin-top:8px;opacity:.8}
.ings{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
.ings li{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:16px;background:#fff;cursor:pointer;user-select:none;border:2px solid #f0e6ff;transition:transform .2s,background .2s}
.ings li:hover{transform:translateY(-2px)}
.ings li .e{font-size:1.6rem}
.ings li.done{background:#e7ffe9;border-color:var(--green);text-decoration:line-through;opacity:.7}
.steps{list-style:none;counter-reset:s;display:grid;gap:10px}
.steps li{counter-increment:s;display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:16px;background:#fff;cursor:pointer;border:2px solid #f0e6ff;transition:transform .2s,background .2s}
.steps li::before{content:counter(s);flex:none;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:700;color:#fff;background:linear-gradient(120deg,var(--c1),var(--c2))}
.steps li:hover{transform:translateX(4px)}
.steps li.done{background:#e7ffe9;border-color:var(--green);opacity:.7}
.steps li.done::before{content:"✓"}
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.prog{height:12px;border-radius:99px;background:#fff;overflow:hidden;margin-bottom:12px;border:2px solid #f0e6ff}
.prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--c1),var(--c2));transition:width .4s}
@media (max-width:720px){.dwrap{grid-template-columns:1fr}.dcup{position:relative;top:0}.grid{grid-template-columns:repeat(2,1fr);gap:12px}.card{padding:12px}.card h3{font-size:1.05rem}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
</head>
