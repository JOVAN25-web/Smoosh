const R=[];
CATS.forEach((c,ci)=>c.data.trim().split('\n').forEach(l=>{
  const k=l.indexOf(':');
  R.push({id:R.length,ci,name:l.slice(0,k).trim(),ings:l.slice(k+1).split(', ').map(s=>s.trim()).filter(Boolean),n:0});
}));
R.forEach((r,i)=>r.n=i);

/* emoji bahan */
const EM=[[/daun mint|mint|basil|kemangi|peterseli|pandan/,'🌿'],[/es batu/,'🧊'],[/stroberi|raspberry/,'🍓'],[/blueberry|blackberry|mulberry/,'🫐'],[/cranberry|ceri|cherry/,'🍒'],
[/brokoli/,'🥦'],[/bayam|kale|kangkung|bok choy|selada|chard|kubis|asparagus|zucchini|wheatgrass|klorofil|spirulina|lidah buaya|aloe/,'🥬'],[/timun|mentimun/,'🥒'],
[/apel hijau/,'🍏'],[/apel/,'🍎'],[/lemon|jeruk nipis|lime|sitrun/,'🍋'],[/jeruk|grapefruit|santang/,'🍊'],[/mangga/,'🥭'],[/nanas/,'🍍'],[/pisang/,'🍌'],[/alpukat/,'🥑'],[/kiwi/,'🥝'],
[/kelapa|santan/,'🥥'],[/melon/,'🍈'],[/semangka/,'🍉'],[/anggur/,'🍇'],[/persik|peach|aprikot/,'🍑'],[/\bpir\b/,'🍐'],[/susu|yogurt|kefir|cream|keju/,'🥛'],[/madu|sirup|maple|molase|gula aren/,'🍯'],
[/kopi|espresso/,'☕'],[/teh|matcha|chamomile|chai/,'🍵'],[/kakao|cokelat|nutella|choco|cacao/,'🍫'],[/jagung/,'🌽'],[/wortel/,'🥕'],[/tomat/,'🍅'],[/labu/,'🎃'],[/ubi/,'🍠'],[/bit\b/,'🟣'],
[/kacang|almond|kenari|mede|hazelnut|pistachio|makadamia|selai|wijen|tahini|hemp|chia|flax|biji|kismis/,'🥜'],[/oats|oatmeal|gandum|granola|biskuit|ketan/,'🌾'],
[/jahe|kunyit|kayu manis|cengkih|kapulaga|pala|lada|cabai|garam/,'✨'],[/vanilla|mawar/,'🌼'],[/protein|kolagen|maca|acai/,'💪'],
[/pepaya|jambu|markisa|passion|sirsak|belimbing|leci|rambutan|manggis|salak|nangka|durian|buah naga|delima|plum|prem|kurma|asam jawa|cendol|fig/,'🌴'],[/air|jus/,'💧']];
const emo=s=>{s=s.toLowerCase();for(const [re,e] of EM)if(re.test(s))return e;return '🥤'};

let uid=0;
function cup(c1,c2,em,hue){
  const id='g'+(uid++);
  return `<svg viewBox="0 0 200 330" class="cup" aria-hidden="true" style="filter:hue-rotate(${hue||0}deg)">
<defs><linearGradient id="${id}l" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${c1}"/><stop offset="1" stop-color="${c2}"/></linearGradient>
<linearGradient id="${id}g" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".6"/><stop offset=".3" stop-color="#fff" stop-opacity=".08"/><stop offset="1" stop-color="#fff" stop-opacity=".3"/></linearGradient>
<clipPath id="${id}c"><path d="M34 70H166L150 304Q149 316 137 316H63Q51 316 50 304Z"/></clipPath></defs>
<rect x="104" y="4" width="13" height="130" rx="6" fill="#ff4081" transform="rotate(12 110 66)"/>
<g clip-path="url(#${id}c)"><rect x="20" y="60" width="160" height="270" fill="#fff" fill-opacity=".3"/>
<path d="M20 112Q50 96 80 112T140 112T200 112V330H20Z" fill="url(#${id}l)"/>
<circle cx="70" cy="200" r="7" fill="#fff" fill-opacity=".5"/><circle cx="128" cy="240" r="10" fill="#fff" fill-opacity=".4"/><circle cx="92" cy="270" r="5" fill="#fff" fill-opacity=".5"/><circle cx="135" cy="160" r="5" fill="#fff" fill-opacity=".45"/></g>
<path d="M34 70H166L150 304Q149 316 137 316H63Q51 316 50 304Z" fill="url(#${id}g)" stroke="#fff" stroke-opacity=".9" stroke-width="4"/>
<rect x="26" y="58" width="148" height="16" rx="8" fill="#fff" fill-opacity=".9"/>
<text x="100" y="50" text-anchor="middle" font-size="44">${em}</text></svg>`;
}

/* langkah pembuatan */
function steps(r){
  const liq=r.ings.filter(i=>/susu|air|jus|santan|teh|kopi|yogurt|kefir|sirup/i.test(i));
  const rest=r.ings.filter(i=>!liq.includes(i));
  const pre=r.ings.filter(i=>/kukus|panggang|matang|rendam|sangrai|dihaluskan/i.test(i));
  const s=['Cuci bersih semua bahan, lalu kupas dan potong buah/sayur menjadi ukuran kecil agar mudah di-blend.'];
  if(pre.length)s.push('Siapkan dulu bahan yang perlu perlakuan khusus ('+pre.map(x=>x.toLowerCase()).join(', ')+') dan pastikan sudah dingin sebelum dipakai.');
  s.push(liq.length?'Tuang bahan cair ke dalam blender lebih dulu: '+liq.join(', ')+'.':'Tuang ±150 ml air dingin ke dalam blender sebagai dasar cairan.');
  if(rest.length)s.push('Masukkan bahan lainnya: '+rest.join(', ')+'.');
  s.push('Tambahkan es batu secukupnya (opsional) agar lebih segar.');
  s.push('Blend 45–60 detik mulai dari kecepatan rendah ke tinggi sampai benar-benar halus. Jika terlalu kental, tambahkan sedikit cairan.');
  s.push('Cicipi, sesuaikan rasa manisnya, tuang ke gelas, dan nikmati selagi dingin! 🥤');
  return s;
}

/* ================= BERANDA 3D ================= */
const sway=document.getElementById('sway');
const heroFruits=[['🍓',-190,-90,60,.3,4.2],['🍌',190,-70,80,.45,5],['🍍',-170,90,100,.6,4.6],['🥭',180,100,40,.75,3.8],['🥝',-40,-170,-30,.9,4.4],['🍊',60,160,90,1.05,5.2],['🫐',-250,0,-40,1.2,4],['🥑',250,10,-30,1.3,4.8]];
sway.innerHTML=`<div class="hero-cup">${cup('#ff4fa3','#ffd93d','🍓')}</div>`+
 heroFruits.map(f=>`<div class="fx" style="--x:${f[1]}px;--y:${f[2]}px;--z:${f[3]}px;--d:${f[4]}s;--t:${f[5]}s">${f[0]}</div>`).join('')+
 [[-120,-10,120,1.4,'8s'],[130,-150,50,1.5,'11s'],[110,40,160,1.6,'9s']].map(c=>`<div class="ice" style="--x:${c[0]}px;--y:${c[1]}px;--z:${c[2]}px"><div class="cube" style="--d:${c[3]}s;--t:${c[4]}"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>`).join('');
const stage=document.getElementById('stage'),scene=document.getElementById('scene');
stage.addEventListener('pointermove',e=>{const b=stage.getBoundingClientRect();const x=(e.clientX-b.left)/b.width-.5,y=(e.clientY-b.top)/b.height-.5;scene.style.setProperty('--ry',(x*40)+'deg');scene.style.setProperty('--rx',(-y*26)+'deg')});
stage.addEventListener('pointerleave',()=>{scene.style.setProperty('--ry','0deg');scene.style.setProperty('--rx','0deg')});
sway.addEventListener('click',e=>{const f=e.target.closest('.fx');if(!f)return;f.classList.remove('boing');void f.offsetWidth;f.classList.add('boing')});
document.getElementById('nextBtn').onclick=()=>location.hash='#explore';
document.getElementById('toHome').onclick=()=>location.hash='#home';

/* ================= EXPLORE ================= */
const $=id=>document.getElementById(id);
let curCat=-1,query='';
const chips=$('chips');
function drawChips(){
  chips.innerHTML=`<button class="chip ${curCat<0?'on':''}" data-c="-1" style="--c1:#ff4fa3;--c2:#9b5cff">🍹 Semua (${R.length})</button>`+
   CATS.map((c,i)=>`<button class="chip ${curCat===i?'on':''}" data-c="${i}" style="--c1:${c.c1};--c2:${c.c2}">${c.icon} ${c.name}</button>`).join('');
}
chips.onclick=e=>{const b=e.target.closest('.chip');if(!b)return;curCat=+b.dataset.c;drawChips();drawGrid()};
function drawGrid(){
  const q=query.trim().toLowerCase();
  const list=R.filter(r=>(curCat<0||r.ci===curCat)&&(!q||r.name.toLowerCase().includes(q)||r.ings.join(' ').toLowerCase().includes(q)||CATS[r.ci].name.toLowerCase().includes(q)));
  $('blurb').textContent=curCat>=0?CATS[curCat].icon+' '+CATS[curCat].blurb:'';
  $('count').textContent=list.length+' menu ditemukan';
  $('grid').innerHTML=list.length?list.map((r,i)=>{const c=CATS[r.ci];
    return `<button class="card" style="--c1:${c.c1};--c2:${c.c2};--i:${i}" data-id="${r.id}" aria-label="Buka resep ${r.name}">
      ${cup(c.c1,c.c2,emo(r.ings[0]),0).replace('class="cup"','class="cup" ').replace(/filter:hue-rotate\(0deg\)/,'filter:none')}
      <h3>${r.name}</h3><p>${r.ings.slice(0,3).map(emo).join(' ')} ${r.ings.slice(0,3).join(', ')}${r.ings.length>3?'…':''}</p><span class="tag">${c.icon} ${c.name}</span></button>`}).join('')
    :`<div class="empty" style="grid-column:1/-1"><b>🫣</b>Belum ada smoothie dengan kata itu.<br>Coba kata lain seperti “pisang”, “jahe”, atau “mangga”.</div>`;
}
$('grid').onclick=e=>{const c=e.target.closest('.card');if(c)location.hash='#r/'+c.dataset.id};
$('q').oninput=e=>{query=e.target.value;drawGrid()};
$('clearQ').onclick=()=>{$('q').value='';query='';drawGrid();$('q').focus()};
$('randomBtn').onclick=()=>location.hash='#r/'+Math.floor(Math.random()*R.length);

/* ================= DETAIL ================= */
const det=$('detail');
function drawDetail(id){
  const r=R[id];if(!r){location.hash='#explore';return}
  const c=CATS[r.ci];const same=R.filter(x=>x.ci===r.ci);const idx=same.indexOf(r);
  const prev=same[(idx+same.length-1)%same.length],next=same[(idx+1)%same.length];
  const st=steps(r);
  det.style.setProperty('--c1',c.c1);det.style.setProperty('--c2',c.c2);
  det.innerHTML=`
  <div class="topbar"><button class="pill" id="back">← Kembali</button><button class="brand" id="home2">SMOOSH</button></div>
  <div class="dwrap">
    <div class="dcup" id="dcup">${cup(c.c1,c.c2,emo(r.ings[0]),0).replace('filter:hue-rotate(0deg)','')}<span class="cat">${c.icon} ${c.name}</span></div>
    <div>
      <div class="panel"><h1>${r.name}</h1><p class="tip">💡 ${c.tip}</p>
        <div class="actions"><button class="pill" id="prev">◀ ${prev.name}</button><button class="pill" id="nxt">${next.name} ▶</button><button class="pill" id="rnd">🎲 Acak</button></div></div>
      <div class="panel"><h2>🧺 Bahan-bahan</h2><ul class="ings" id="ings">${r.ings.map(i=>`<li tabindex="0"><span class="e">${emo(i)}</span>${i}</li>`).join('')}</ul></div>
      <div class="panel"><h2>👩‍🍳 Langkah pembuatan</h2><div class="prog"><i id="prog"></i></div><ol class="steps" id="steps">${st.map(s=>`<li tabindex="0">${s}</li>`).join('')}</ol></div>
    </div>
  </div>`;
  const toggle=e=>{const li=e.target.closest('li');if(!li)return;li.classList.toggle('done');upd()};
  const upd=()=>{const a=det.querySelectorAll('#steps li'),d=det.querySelectorAll('#steps li.done');$('prog').style.width=(d.length/a.length*100)+'%'};
  ['ings','steps'].forEach(k=>{const el=$(k);el.onclick=toggle;el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle(e)}}});
  $('back').onclick=()=>location.hash='#explore';$('home2').onclick=()=>location.hash='#home';
  $('prev').onclick=()=>location.hash='#r/'+prev.id;$('nxt').onclick=()=>location.hash='#r/'+next.id;$('rnd').onclick=()=>location.hash='#r/'+Math.floor(Math.random()*R.length);
  const dc=$('dcup');dc.onpointermove=e=>{const b=dc.getBoundingClientRect();dc.style.setProperty('--ry',((e.clientX-b.left)/b.width-.5)*40+'deg');dc.style.setProperty('--rx',(-((e.clientY-b.top)/b.height-.5))*30+'deg')};
  dc.onpointerleave=()=>{dc.style.setProperty('--ry','0deg');dc.style.setProperty('--rx','0deg')};
}

/* ================= ROUTER ================= */
function show(id){['home','explore','detail'].forEach(v=>{const el=$(v);el.classList.toggle('hidden',v!==id);if(v===id){el.style.animation='none';void el.offsetWidth;el.style.animation=''}});scrollTo(0,0)}
function route(){
  const h=location.hash||'#home';
  if(h.startsWith('#r/')){drawDetail(+h.slice(3));show('detail')}
  else if(h==='#explore')show('explore');
  else show('home');
}
addEventListener('hashchange',route);
drawChips();drawGrid();route();
</script>
</body>
</html>
